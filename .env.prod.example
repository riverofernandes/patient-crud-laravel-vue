# Production settings for docker-compose.prod.yml. Copy to .env.prod (git-ignored) and fill in once:
#   cp .env.prod.example .env.prod
#   sed -i.bak "s|^APP_KEY=.*|APP_KEY=base64:$(openssl rand -base64 32)|" .env.prod && rm .env.prod.bak
# NEVER regenerate APP_KEY after the first deploy: CPF, clinical data, photos and attachments are encrypted with it.
APP_KEY=
# Optional dedicated key for the CPF blind index (empty = derived from APP_KEY).
CPF_HASH_KEY=
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
API_PORT=8000
WEB_PORT=8080
API_RATE_LIMIT=300
PHOTO_RATE_LIMIT=1200
# Seed demo data on start (true only for a demo environment).
SEED_ON_START=false
