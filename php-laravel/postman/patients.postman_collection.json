{
  "info": {
    "name": "Pacientes API",
    "description": "CRUD de pacientes (Laravel): listagem com filtros e ordenação, exportação CSV, lixeira, restauração, histórico de alterações e verificação de CPF. Contrato: docs/API_CONTRACT.md. Execute em ordem (Runner/newman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "patientId",
      "value": "1"
    },
    {
      "key": "cpf",
      "value": "62518953060"
    },
    {
      "key": "cpfMasked",
      "value": ""
    },
    {
      "key": "cpfPartial",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Listar pacientes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Paginated payload', function () { const j = pm.response.json(); pm.expect(j).to.have.keys('data', 'links', 'meta'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients?page=1&per_page=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "per_page",
              "value": "10"
            }
          ]
        },
        "description": "Lista paginada ordenada por nome (padrão)."
      }
    },
    {
      "name": "Listar pacientes ordenados (data de nascimento desc)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Sorted by birth_date desc, ties by id asc', function () {",
              "  const d = pm.response.json().data;",
              "  for (let i = 1; i < d.length; i++) {",
              "    const prev = d[i - 1], cur = d[i];",
              "    pm.expect(prev.birth_date >= cur.birth_date).to.be.true;",
              "    if (prev.birth_date === cur.birth_date) { pm.expect(prev.id).to.be.below(cur.id); }",
              "  }",
              "});",
              "pm.test('Items expose age and deleted_at', function () { pm.response.json().data.forEach(p => { pm.expect(p.age).to.be.a('number'); pm.expect(p.deleted_at).to.eql(null); }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients?sort=birth_date&direction=desc&per_page=25",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ],
          "query": [
            {
              "key": "sort",
              "value": "birth_date"
            },
            {
              "key": "direction",
              "value": "desc"
            },
            {
              "key": "per_page",
              "value": "25"
            }
          ]
        },
        "description": "sort: name | birth_date | created_at (padrão name; inválido → name). direction: asc | desc (padrão asc). Desempate por id asc."
      }
    },
    {
      "name": "Listar com filtros (sexo e faixa etária)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const j = pm.response.json();",
              "pm.test('Only F aged 18-60', function () { j.data.forEach(p => { pm.expect(p.sex).to.eql('F'); pm.expect(p.age).to.be.within(18, 60); }); });",
              "pm.test('Filters kept in pagination links', function () { if (j.links.next) { ['sex=F', 'age_min=18', 'age_max=60'].forEach(s => pm.expect(j.links.next).to.include(s)); } });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients?sex=F&age_min=18&age_max=60&per_page=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ],
          "query": [
            {
              "key": "sex",
              "value": "F"
            },
            {
              "key": "age_min",
              "value": "18"
            },
            {
              "key": "age_max",
              "value": "60"
            },
            {
              "key": "per_page",
              "value": "5"
            }
          ]
        },
        "description": "Filtros `sex` (M|F) e `age_min`/`age_max` (anos completos, 0–150; inválido é ignorado), combináveis com busca, ordenação e lixeira."
      }
    },
    {
      "name": "Buscar pacientes (nome ou CPF completo)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients?search=Maria",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ],
          "query": [
            {
              "key": "search",
              "value": "Maria"
            }
          ]
        },
        "description": "Busca por nome parcial ou CPF com/sem máscara (ex.: 625.189.530-60)."
      }
    },
    {
      "name": "Cadastrar paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('Stores digits only', function () { pm.expect(body.data.phone).to.eql('11928535718'); pm.expect(body.data.rg).to.eql('35688019X'); });",
              "pm.collectionVariables.set('patientId', body.data.id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generates a fresh valid CPF so the collection can be run repeatedly.",
              "const d = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));",
              "for (const len of [9, 10]) {",
              "  const sum = d.slice(0, len).reduce((acc, n, i) => acc + n * (len + 1 - i), 0);",
              "  d.push((sum * 10) % 11 % 10);",
              "}",
              "pm.collectionVariables.set('cpf', d.join(''));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ]
        },
        "description": "201 com o paciente criado. CPF/RG/celular podem vir com máscara; são armazenados só com dígitos. O pre-request gera um CPF válido em {{cpf}}.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Maria da Silva\",\n  \"cpf\": \"{{cpf}}\",\n  \"rg\": \"35.688.019-X\",\n  \"birth_date\": \"1996-07-20\",\n  \"sex\": \"F\",\n  \"phone\": \"(11) 92853-5718\",\n  \"email\": \"maria@example.com\",\n  \"description\": \"Paciente com miopia leve.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Buscar por CPF completo (com máscara)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Finds the patient by full CPF', function () { const d = pm.response.json().data; pm.expect(d.map(x => x.id)).to.include(Number(pm.collectionVariables.get('patientId'))); });"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const c = pm.collectionVariables.get('cpf');",
              "pm.collectionVariables.set('cpfMasked', `${c.slice(0, 3)}.${c.slice(3, 6)}.${c.slice(6, 9)}-${c.slice(9)}`);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients?search={{cpfMasked}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ],
          "query": [
            {
              "key": "search",
              "value": "{{cpfMasked}}"
            }
          ]
        },
        "description": "O CPF é criptografado; a busca usa um hash (blind index) e só encontra o CPF completo (11 dígitos, com ou sem máscara)."
      }
    },
    {
      "name": "Buscar por CPF parcial (sem resultado)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Partial CPF does not match', function () { const d = pm.response.json().data; pm.expect(d.map(x => x.id)).to.not.include(Number(pm.collectionVariables.get('patientId'))); });"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('cpfPartial', pm.collectionVariables.get('cpf').slice(0, 6));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients?search={{cpfPartial}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ],
          "query": [
            {
              "key": "search",
              "value": "{{cpfPartial}}"
            }
          ]
        },
        "description": "CPF parcial não é buscável (o CPF é armazenado criptografado)."
      }
    },
    {
      "name": "Exportar pacientes (CSV)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('CSV headers', function () {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.eql('text/csv; charset=UTF-8');",
              "  pm.expect(pm.response.headers.get('Content-Disposition')).to.match(/^attachment; filename=\"pacientes-\\d{8}-\\d{4}\\.csv\"$/);",
              "});",
              "const text = pm.response.text().replace(/^\\uFEFF/, ''); // text() may drop the BOM; the raw bytes are checked below",
              "pm.test('BOM, separator, CRLF and header', function () {",
              "  const raw = pm.response.stream; pm.expect([raw[0], raw[1], raw[2]]).to.eql([0xEF, 0xBB, 0xBF]);",
              "  pm.expect(text.split('\\r\\n')[0]).to.eql('Nome;CPF;RG;Data de nascimento;Idade;Sexo;Celular;E-mail;Descrição');",
              "});",
              "pm.test('Formatted row for the patient', function () {",
              "  const row = text.split('\\r\\n')[1];",
              "  pm.expect(row).to.include(pm.collectionVariables.get('cpfMasked'));",
              "  pm.expect(row).to.include(';Feminino;(11) 92853-5718;');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/export?search={{cpf}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "export"
          ],
          "query": [
            {
              "key": "search",
              "value": "{{cpf}}"
            }
          ]
        },
        "description": "Mesmos filtros e ordenação da listagem, sem paginação. UTF-8 com BOM, separador `;`, CRLF; valores formatados."
      }
    },
    {
      "name": "Verificar CPF (em uso)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('CPF taken by the created patient', function () { pm.expect(pm.response.json()).to.eql({ available: false, message: 'Já existe um paciente cadastrado com este CPF.' }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/cpf-availability?cpf={{cpf}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "cpf-availability"
          ],
          "query": [
            {
              "key": "cpf",
              "value": "{{cpf}}"
            }
          ]
        },
        "description": "Verifica se o CPF pode ser usado (aceita máscara). Pacientes excluídos não contam."
      }
    },
    {
      "name": "Verificar CPF (ignorando o próprio paciente)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Available when ignoring the patient being edited', function () { pm.expect(pm.response.json()).to.eql({ available: true }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/cpf-availability?cpf={{cpf}}&ignore={{patientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "cpf-availability"
          ],
          "query": [
            {
              "key": "cpf",
              "value": "{{cpf}}"
            },
            {
              "key": "ignore",
              "value": "{{patientId}}"
            }
          ]
        },
        "description": "Na edição, envie ignore com o ID do próprio paciente."
      }
    },
    {
      "name": "Verificar CPF (inválido - 422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 422', function () { pm.response.to.have.status(422); });",
              "pm.test('Same message as create', function () { pm.expect(pm.response.json().errors.cpf[0]).to.eql('O CPF informado é inválido.'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/cpf-availability?cpf=123.456.789-00",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "cpf-availability"
          ],
          "query": [
            {
              "key": "cpf",
              "value": "123.456.789-00"
            }
          ]
        },
        "description": "CPF inválido retorna 422 com as mesmas mensagens do cadastro."
      }
    },
    {
      "name": "Detalhar paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Has age and deleted_at', function () { const d = pm.response.json().data; pm.expect(d.age).to.be.a('number'); pm.expect(d.deleted_at).to.eql(null); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/{{patientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "{{patientId}}"
          ]
        },
        "description": "200 ou 404 {\"message\":\"Paciente não encontrado.\"}"
      }
    },
    {
      "name": "Cadastrar paciente (inválido - 422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 422', function () { pm.response.to.have.status(422); });",
              "pm.test('Validation errors in pt-BR', function () { const j = pm.response.json(); pm.expect(j.errors.name[0]).to.eql('O campo nome completo é obrigatório.'); pm.expect(j.errors.cpf[0]).to.eql('O CPF informado é inválido.'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ]
        },
        "description": "Exemplo de erro de validação 422 com mensagens em pt-BR.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"cpf\": \"123.456.789-00\",\n  \"rg\": \"\",\n  \"birth_date\": \"2999-01-01\",\n  \"sex\": \"X\",\n  \"phone\": \"123\",\n  \"email\": \"email-invalido\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Atualizar paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Name updated', function () { pm.expect(pm.response.json().data.name).to.eql('Maria da Silva Souza'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/{{patientId}}",
          "host": [
