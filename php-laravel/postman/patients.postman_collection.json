{
  "info": {
    "name": "Pacientes API",
    "description": "CRUD de pacientes (Laravel): listagem com ordenação, lixeira, restauração e verificação de CPF. Contrato: docs/API_CONTRACT.md. Execute em ordem (Runner/newman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "patientId",
      "value": "1"
    },
    {
      "key": "cpf",
      "value": "62518953060"
    }
  ],
  "item": [
    {
      "name": "Listar pacientes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Paginated payload', function () { const j = pm.response.json(); pm.expect(j).to.have.keys('data', 'links', 'meta'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients?page=1&per_page=10",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ],
          "query": [
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "per_page",
              "value": "10"
            }
          ]
        },
        "description": "Lista paginada ordenada por nome (padrão)."
      }
    },
    {
      "name": "Listar pacientes ordenados (data de nascimento desc)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Sorted by birth_date desc, ties by id asc', function () {",
              "  const d = pm.response.json().data;",
              "  for (let i = 1; i < d.length; i++) {",
              "    const prev = d[i - 1], cur = d[i];",
              "    pm.expect(prev.birth_date >= cur.birth_date).to.be.true;",
              "    if (prev.birth_date === cur.birth_date) { pm.expect(prev.id).to.be.below(cur.id); }",
              "  }",
              "});",
              "pm.test('Items expose age and deleted_at', function () { pm.response.json().data.forEach(p => { pm.expect(p.age).to.be.a('number'); pm.expect(p.deleted_at).to.eql(null); }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients?sort=birth_date&direction=desc&per_page=25",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ],
          "query": [
            {
              "key": "sort",
              "value": "birth_date"
            },
            {
              "key": "direction",
              "value": "desc"
            },
            {
              "key": "per_page",
              "value": "25"
            }
          ]
        },
        "description": "sort: name | birth_date | created_at (padrão name; inválido → name). direction: asc | desc (padrão asc). Desempate por id asc."
      }
    },
    {
      "name": "Buscar pacientes (nome ou CPF)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients?search=Maria",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ],
          "query": [
            {
              "key": "search",
              "value": "Maria"
            }
          ]
        },
        "description": "Busca por nome parcial ou CPF com/sem máscara (ex.: 625.189.530-60)."
      }
    },
    {
      "name": "Cadastrar paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('Stores digits only', function () { pm.expect(body.data.phone).to.eql('11928535718'); pm.expect(body.data.rg).to.eql('35688019X'); });",
              "pm.collectionVariables.set('patientId', body.data.id);"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Generates a fresh valid CPF so the collection can be run repeatedly.",
              "const d = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));",
              "for (const len of [9, 10]) {",
              "  const sum = d.slice(0, len).reduce((acc, n, i) => acc + n * (len + 1 - i), 0);",
              "  d.push((sum * 10) % 11 % 10);",
              "}",
              "pm.collectionVariables.set('cpf', d.join(''));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ]
        },
        "description": "201 com o paciente criado. CPF/RG/celular podem vir com máscara; são armazenados só com dígitos. O pre-request gera um CPF válido em {{cpf}}.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Maria da Silva\",\n  \"cpf\": \"{{cpf}}\",\n  \"rg\": \"35.688.019-X\",\n  \"birth_date\": \"1996-07-20\",\n  \"sex\": \"F\",\n  \"phone\": \"(11) 92853-5718\",\n  \"email\": \"maria@example.com\",\n  \"description\": \"Paciente com miopia leve.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Verificar CPF (em uso)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('CPF taken by the created patient', function () { pm.expect(pm.response.json()).to.eql({ available: false, message: 'Já existe um paciente cadastrado com este CPF.' }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/cpf-availability?cpf={{cpf}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "cpf-availability"
          ],
          "query": [
            {
              "key": "cpf",
              "value": "{{cpf}}"
            }
          ]
        },
        "description": "Verifica se o CPF pode ser usado (aceita máscara). Pacientes excluídos não contam."
      }
    },
    {
      "name": "Verificar CPF (ignorando o próprio paciente)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Available when ignoring the patient being edited', function () { pm.expect(pm.response.json()).to.eql({ available: true }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/cpf-availability?cpf={{cpf}}&ignore={{patientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "cpf-availability"
          ],
          "query": [
            {
              "key": "cpf",
              "value": "{{cpf}}"
            },
            {
              "key": "ignore",
              "value": "{{patientId}}"
            }
          ]
        },
        "description": "Na edição, envie ignore com o ID do próprio paciente."
      }
    },
    {
      "name": "Verificar CPF (inválido - 422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 422', function () { pm.response.to.have.status(422); });",
              "pm.test('Same message as create', function () { pm.expect(pm.response.json().errors.cpf[0]).to.eql('O CPF informado é inválido.'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/cpf-availability?cpf=123.456.789-00",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "cpf-availability"
          ],
          "query": [
            {
              "key": "cpf",
              "value": "123.456.789-00"
            }
          ]
        },
        "description": "CPF inválido retorna 422 com as mesmas mensagens do cadastro."
      }
    },
    {
      "name": "Detalhar paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Has age and deleted_at', function () { const d = pm.response.json().data; pm.expect(d.age).to.be.a('number'); pm.expect(d.deleted_at).to.eql(null); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/{{patientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "{{patientId}}"
          ]
        },
        "description": "200 ou 404 {\"message\":\"Paciente não encontrado.\"}"
      }
    },
    {
      "name": "Cadastrar paciente (inválido - 422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 422', function () { pm.response.to.have.status(422); });",
              "pm.test('Validation errors in pt-BR', function () { const j = pm.response.json(); pm.expect(j.errors.name[0]).to.eql('O campo nome completo é obrigatório.'); pm.expect(j.errors.cpf[0]).to.eql('O CPF informado é inválido.'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ]
        },
        "description": "Exemplo de erro de validação 422 com mensagens em pt-BR.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"cpf\": \"123.456.789-00\",\n  \"rg\": \"\",\n  \"birth_date\": \"2999-01-01\",\n  \"sex\": \"X\",\n  \"phone\": \"123\",\n  \"email\": \"email-invalido\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Atualizar paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Name updated', function () { pm.expect(pm.response.json().data.name).to.eql('Maria da Silva Souza'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/{{patientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "{{patientId}}"
          ]
        },
        "description": "Substituição completa; envie todos os campos editáveis (opcionais omitidos viram null).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Maria da Silva Souza\",\n  \"cpf\": \"{{cpf}}\",\n  \"rg\": \"35.688.019-X\",\n  \"birth_date\": \"1996-07-20\",\n  \"sex\": \"F\",\n  \"phone\": \"11987654321\",\n  \"email\": \"maria@example.com\",\n  \"description\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Excluir paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/{{patientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "{{patientId}}"
          ]
        },
        "description": "Soft delete. 204 sem corpo."
      }
    },
    {
      "name": "Detalhar paciente excluído (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', function () { pm.response.to.have.status(404); });",
              "pm.test('Not found message', function () { pm.expect(pm.response.json().message).to.eql('Paciente não encontrado.'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/{{patientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "{{patientId}}"
          ]
        },
        "description": "Após a exclusão o paciente retorna 404."
      }
    },
    {
      "name": "Listar lixeira (pacientes excluídos)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Deleted patient is in the trash', function () {",
              "  const d = pm.response.json().data;",
              "  const p = d.find(x => x.id === Number(pm.collectionVariables.get('patientId')));",
              "  pm.expect(p, 'patient in trash').to.be.an('object');",
              "  d.forEach(x => pm.expect(x.deleted_at).to.be.a('string'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients?trashed=only&search={{cpf}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ],
          "query": [
            {
              "key": "trashed",
              "value": "only"
            },
            {
              "key": "search",
              "value": "{{cpf}}"
            }
          ]
        },
        "description": "trashed=only lista apenas pacientes excluídos (deleted_at preenchido); busca, ordenação e paginação continuam valendo."
      }
    },
    {
      "name": "Restaurar paciente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Restored (deleted_at null)', function () { const d = pm.response.json().data; pm.expect(d.id).to.eql(Number(pm.collectionVariables.get('patientId'))); pm.expect(d.deleted_at).to.eql(null); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/{{patientId}}/restore",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "{{patientId}}",
            "restore"
          ]
        },
        "description": "Restaura da lixeira. 404 se não existir ou não estiver excluído; 409 {\"message\":\"Já existe um paciente ativo com este CPF.\"} se outro paciente ativo usar o CPF."
      }
    },
    {
      "name": "Restaurar paciente ativo (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', function () { pm.response.to.have.status(404); });",
              "pm.test('Not found message', function () { pm.expect(pm.response.json().message).to.eql('Paciente não encontrado.'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/{{patientId}}/restore",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "{{patientId}}",
            "restore"
          ]
        },
        "description": "Só pacientes na lixeira podem ser restaurados."
      }
    },
    {
      "name": "Excluir paciente (limpeza)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 204', function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/{{patientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "{{patientId}}"
          ]
        },
        "description": "Remove o paciente de teste ao final, para execuções repetidas não acumularem registros ativos."
      }
    }
  ]
}
