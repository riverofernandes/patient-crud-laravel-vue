        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Maria da Silva Souza\",\n  \"cpf\": \"{{cpf}}\",\n  \"rg\": \"35.688.019-X\",\n  \"birth_date\": \"1996-07-20\",\n  \"sex\": \"F\",\n  \"phone\": \"11987654321\",\n  \"email\": \"maria@example.com\",\n  \"description\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
