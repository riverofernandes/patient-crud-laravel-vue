      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 404', function () { pm.response.to.have.status(404); });",
              "pm.test('Not found message', function () { pm.expect(pm.response.json().message).to.eql('Paciente não encontrado.'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/{{patientId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "{{patientId}}"
          ]
        },
        "description": "Após a exclusão o paciente retorna 404."
      }
    },
    {
      "name": "Listar lixeira (pacientes excluídos)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Deleted patient is in the trash', function () {",
              "  const d = pm.response.json().data;",
              "  const p = d.find(x => x.id === Number(pm.collectionVariables.get('patientId')));",
              "  pm.expect(p, 'patient in trash').to.be.an('object');",
              "  d.forEach(x => pm.expect(x.deleted_at).to.be.a('string'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients?trashed=only&search={{cpf}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients"
          ],
          "query": [
            {
              "key": "trashed",
              "value": "only"
            },
            {
              "key": "search",
              "value": "{{cpf}}"
            }
          ]
        },
        "description": "trashed=only lista apenas pacientes excluídos (deleted_at preenchido); busca, ordenação e paginação continuam valendo."
      }
    },
    {
      "name": "Exportar lixeira (CSV)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Has the Excluído em column', function () {",
              "  const lines = pm.response.text().replace(/^\\uFEFF/, '').split('\\r\\n');",
              "  pm.expect(lines[0]).to.eql('Nome;CPF;RG;Data de nascimento;Idade;Sexo;Celular;E-mail;Descrição;Excluído em');",
              "  pm.expect(lines[1]).to.match(/;\\d{2}\\/\\d{2}\\/\\d{4} \\d{2}:\\d{2}$/);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/patients/export?trashed=only&search={{cpf}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "patients",
            "export"
          ],
